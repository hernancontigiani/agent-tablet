#!/usr/bin/make -f
export PYBUILD_NAME=agent_tablet

%:
	dh $@ --with python3 --buildsystem=pybuild

# The wheel ships the package + the agent-tablet command. The desktop
# entry, icons, and metainfo are not in the wheel, so install them here.
execute_after_dh_install:
	install -Dm644 data/io.github.hernancontigiani.AgentTablet.metainfo.xml \
	  debian/agent-tablet/usr/share/metainfo/io.github.hernancontigiani.AgentTablet.metainfo.xml
	install -Dm644 data/icons/io.github.hernancontigiani.AgentTablet.svg \
	  debian/agent-tablet/usr/share/icons/hicolor/scalable/apps/io.github.hernancontigiani.AgentTablet.svg
	install -Dm644 data/icons/hicolor/scalable/actions/tab-close-symbolic.svg \
	  debian/agent-tablet/usr/share/icons/hicolor/scalable/actions/tab-close-symbolic.svg
	install -d debian/agent-tablet/usr/share/applications
	sed -e 's|^Exec=.*|Exec=agent-tablet|' -e '/^Path=/d' \
	  data/io.github.hernancontigiani.AgentTablet.desktop \
	  > debian/agent-tablet/usr/share/applications/io.github.hernancontigiani.AgentTablet.desktop
